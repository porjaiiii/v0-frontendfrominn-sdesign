# Copy to .env.local and fill in. Never commit .env.local.

# ── Google Apps Script endpoints ──────────────────────────────────────────
# URL1: registration, coupons, admin, waste records, image upload
NEXT_PUBLIC_GAS_URL1=
# URL2: points ledger (earn / spend / resync)
NEXT_PUBLIC_GAS_URL2=
NEXT_PUBLIC_GAS_URL3=

# ── Google Sheets (direct read API) ───────────────────────────────────────
POINTS_SPREADSHEET_ID=
REGISTRATION_SHEETS_ID=
GOOGLE_SHEETS_API_KEY=

# ── LINE / LIFF ───────────────────────────────────────────────────────────
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=

# ── Vercel Blob (image storage) ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_SESSION_SECRET=

# ── Environment ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENV=

# ── Supabase (migration in progress; unused by the GAS write paths) ───────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_DEFAULT=

# ── Idempotency layer ─────────────────────────────────────────────────────
# Set to 1 (or true) to enable request deduplication on the points-spend,
# waste-submit, waste-update, and register routes. Default off.
# Read per-request, so it can be flipped in Vercel without a redeploy.
IDEMPOTENCY_ENABLED=
