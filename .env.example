# ---------------------------------------------------------------------------
# Supabase — hosted project. `supabase link --project-ref <ref>` then
# `supabase db push` (migrations) and `supabase config push` (exposes the
# `app` schema — db push alone does NOT do this). Keys: Dashboard →
# Settings → API. The service-role key is server-only — it must never gain a
# NEXT_PUBLIC_ prefix, or it ships in the client bundle readable by anyone.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Backend selection (lib/backend-flags.ts)
#
# Everything defaults to `gas`, so an unset environment behaves exactly as it
# does today. Flip per route to cut over or roll back without a deploy.
# ---------------------------------------------------------------------------
BACKEND_DEFAULT=gas
# BACKEND_PROFILE=supabase
# BACKEND_REGISTER=supabase
# BACKEND_WASTE_RECORDS=supabase
# BACKEND_WASTE_SUBMIT=supabase
# BACKEND_WASTE_UPDATE=supabase
# BACKEND_POINTS=supabase
# BACKEND_COUPONS=supabase

# Freeze window for the prod cutover.
# MAINTENANCE=1

# ---------------------------------------------------------------------------
# LINE
#
# No dev bypass exists — every environment, local included, authenticates
# through a real LIFF session and a real verified ID token.
# ---------------------------------------------------------------------------
# From the LINE Developers Console → your channel → LIFF. Required for
# hooks/use-liff.ts to initialise; without it the app cannot log anyone in.
NEXT_PUBLIC_LIFF_ID=
# LINE Login channel id — the `aud` claim of the ID token, required by
# lib/auth/verify-line-token.ts. This is the part of NEXT_PUBLIC_LIFF_ID before
# the dash: a LIFF id is always `{channelId}-{liffAppId}`.
LINE_CHANNEL_ID=
# Only needed if any client still sends HS256 ID tokens.
LINE_CHANNEL_SECRET=

# ---------------------------------------------------------------------------
# Legacy Google Apps Script — removed in Phase 9
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GAS_URL1=
NEXT_PUBLIC_GAS_URL2=
POINTS_SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=

# GAS #3 — the "LINE OA GAS" deployment that greets a newly registered user.
# Called server-side by lib/notify-registration.ts; the script itself is
# unchanged. Both must be set or the greeting is skipped (registration still
# succeeds, and a warning is logged once per process).
#
# Deliberately NOT prefixed NEXT_PUBLIC_: that prefix inlines the value into the
# client bundle, which is how the secret below became publicly readable in the
# first place. NEXT_PUBLIC_GAS_URL3 is still honoured as a fallback for the URL
# so nothing breaks mid-rename — remove it once GAS_URL3 is set.
GAS_URL3=
# Set to the current value to preserve today's behaviour, then rotate it here
# and in the Apps Script project — it has been readable in the client bundle.
GAS_REGISTRATION_SECRET=

# ---------------------------------------------------------------------------
# Admin sessions
# ---------------------------------------------------------------------------
# HMAC key for the httpOnly admin cookie (lib/auth/admin-session.ts). At least
# 32 characters: `openssl rand -base64 48`. Unset means nobody is an admin —
# the guard fails closed rather than erroring.
#
# Rotating this logs every admin out, which is the intended panic button.
ADMIN_SESSION_SECRET=
